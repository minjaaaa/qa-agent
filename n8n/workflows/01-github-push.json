      ],
      "id": "5977b16c-8be6-4bb0-b7f8-cbbe4b85139b",
      "name": "Webhook",
      "webhookId": "99a94629-dc03-4dbb-aff1-4d47e1842f23"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst item = $input.first();\nconst potpis = (item.json.headers || {})['x-hub-signature-256'];\n\nif (!potpis) {\n  throw new Error('Nedostaje X-Hub-Signature-256 header');\n}\n\nconst secret = $env.GITHUB_WEBHOOK_SECRET;\nif (!secret) {\n  throw new Error('GITHUB_WEBHOOK_SECRET nije stigao do kontejnera');\n}\n\nconst sirovo = item.binary && item.binary.data\n  ? Buffer.from(item.binary.data.data, 'base64')\n  : Buffer.from(JSON.stringify(item.json.body), 'utf8');\n\nconst ocekivano = 'sha256=' + crypto\n  .createHmac('sha256', secret)\n  .update(sirovo)\n  .digest('hex');\n\nconst a = Buffer.from(ocekivano);\nconst b = Buffer.from(potpis);\n\nif (a.length !== b.length || !crypto.timingSafeEqual(a, b)) {\n  throw new Error('Potpis nije validan, zahtev nije od GitHub-a');\n}\n\nreturn [{ json: JSON.parse(sirovo.toString('utf8')) }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        16
      ],
      "id": "325d0a17-f504-4051-b93d-d74ba4ba0e15",
      "name": "Provera potpisa"
    },
    {
      "parameters": {
        "jsCode": "const p = $input.first().json;\n\nconst ref = p.ref || '';\nconst grana = ref.replace('refs/heads/', '');\nconst jeGrana = ref.startsWith('refs/heads/');\n\nconst commits = p.commits || [];\n\nconst fajlovi = new Set();\nfor (const c of commits) {\n  for (const f of [...(c.added || []), ...(c.modified || [])]) {\n    fajlovi.add(f);\n  }\n}\nfor (const c of commits) {\n  for (const f of (c.removed || [])) {\n    fajlovi.delete(f);\n  }\n}\n\nconst svi = [...fajlovi];\nconst python = svi.filter(f => f.endsWith('.py') && !f.startsWith('tests/'));\n\nreturn [{\n  json: {\n    repo: p.repository?.full_name || null,\n    grana,\n    jeGrana,\n    obrisana: p.deleted === true,\n    before: p.before,\n    after: p.after,\n    autor: p.pusher?.name || null,\n    autorTip: p.sender?.type || null,\n    porukaCommita: p.head_commit?.message || '',\n    brojCommita: commits.length,\n    sviFajlovi: svi,\n    pythonFajlovi: python,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        16
      ],
