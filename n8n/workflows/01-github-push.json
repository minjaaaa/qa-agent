    {
      "parameters": {
        "jsCode": "const meta = $('Izvuci podatke').first().json;\nconst ulaz = $input.first().json;\nconst diff = typeof ulaz.data === 'string' ? ulaz.data : String(ulaz);\n\nreturn [{\n  json: {\n    verzija: 1,\n    repo: meta.repo,\n    grana: meta.grana,\n    granaAgenta: 'qa-agent/' + meta.grana,\n    commitSha: meta.after,\n    autor: meta.autor,\n    porukaCommita: meta.porukaCommita,\n    izmenjeniFajlovi: meta.pythonFajlovi,\n    diff: diff,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1168,
        -80
      ],
      "id": "66bc011d-c8d7-436c-95f2-c9465deb303f",
      "name": "Ugovor"
    },
    {
      "parameters": {
        "jsCode": "const d = $('Ugovor').first().json;\nconst rezultat = $input.first().json;\nconst putanje = rezultat.generisaniTestovi\n  .map(t => t.putanja)\n  .join('\\n');\n\nreturn [{\n  json: {\n    blocks: [\n      {\n        type: 'header',\n        text: { type: 'plain_text', text: 'Testovi generisani' }\n      },\n      {\n        type: 'section',\n        fields: [\n          { type: 'mrkdwn', text: `*Repo:*\\n${d.repo}` },\n          { type: 'mrkdwn', text: `*Grana:*\\n${d.grana}` },\n          { type: 'mrkdwn', text: `*Autor:*\\n${d.autor}` },\n          { type: 'mrkdwn', text: `*Fajlovi:*\\n${d.izmenjeniFajlovi.join(', ')}` }\n        ]\n      },\n            {\n        type: 'section',\n        text: {\n          type: 'mrkdwn',\n          text: `*Generisani testovi:*\\n${putanje}`\n        }\n      },\n      {\n        type: 'context',\n        elements: [\n          { type: 'mrkdwn', text: `Commit: ${d.porukaCommita}` }\n        ]\n      }\n    ]\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
